{
  "name": "@cadenya/widgets-ui-react",
  "version": "0.1.0",
  "description": "React UI kit for embedding Cadenya widgets: conversations, streaming, tool approvals, custom tool renderers. Built on Radix Themes.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cadenya/widgets-ui-react.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cadenya/widgets": "^1.0.1",
    "@radix-ui/react-icons": "^1.3.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@radix-ui/themes": "^3.2.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@radix-ui/themes": "^3.3.0",
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
