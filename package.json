{
  "name": "@cadenya/widgets-ui-react",
  "version": "0.1.0",
  "description": "React UI kit for embedding Cadenya widgets: conversations, streaming, tool approvals, custom tool renderers. Built on Radix Themes.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cadenya/widgets-ui-react.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/styles.css dist/styles.css",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "npm run build && publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css && node --input-type=module -e \"const m = await import('./dist/index.js'); if (!m.ConversationsPanel || !m.usePageTool) throw new Error('missing exports'); console.log('node import smoke: ok');\""
  },
  "dependencies": {
    "@cadenya/widgets": "^1.0.1",
    "@radix-ui/react-icons": "^1.3.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@radix-ui/themes": "^3.2.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@radix-ui/themes": "^3.3.0",
    "@types/react": "^19",
    "publint": "^0.3.0",
    "react": "^19",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
